--───────────── СБОРКА ПУШКИ ─────────────
local currentTool = nil
local equippedTool = nil
local fireBusy = false

local function buildAndGive()
    if currentTool then pcall(function() currentTool:Destroy() end) end
    equippedTool = nil

    local asset = loadGunModel()
    if not asset then return end

    local mainModel = Instance.new("Model")
    mainModel.Name = "GunParts"
    asset.Parent = mainModel

    for _, d in ipairs(mainModel:GetDescendants()) do
        if d:IsA("BaseScript") or d:IsA("Sound") then d:Destroy() end
    end
    for _, d in ipairs(mainModel:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = false
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
            d.Massless = true
        end
    end

    pcall(function() mainModel:ScaleTo(CONFIG.SCALE) end)

    local bbCF = mainModel:GetBoundingBox()
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.4, 0.4, 0.4)
    handle.Transparency = 1
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true
    handle.CFrame = bbCF

    local tool = Instance.new("Tool")
    tool.Name = CONFIG.GUN_NAME
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    tool.ToolTip = "Портальная пушка [ЛКМ]"

    handle.Parent = tool
    mainModel.Parent = tool

    for _, d in ipairs(mainModel:GetDescendants()) do
        if d:IsA("BasePart") and d ~= handle then
            local wc = Instance.new("WeldConstraint")
            wc.Part0 = handle
            wc.Part1 = d
            wc.Parent = handle
        end
    end

    tool.Grip = CFrame.new(CONFIG.GRIP_POS)
        * CFrame.Angles(
            math.rad(CONFIG.GRIP_ROT.X),
            math.rad(CONFIG.GRIP_ROT.Y),
            math.rad(CONFIG.GRIP_ROT.Z))

    tool.Parent = LocalPlayer:WaitForChild("Backpack")
    currentTool = tool

    tool.Equipped:Connect(function() equippedTool = tool end)
    tool.Unequipped:Connect(function()
        if equippedTool == tool then equippedTool = nil end
    end)

    local farPart, farDist = nil, 0
    for _, d in ipairs(mainModel:GetDescendants()) do
        if d:IsA("BasePart") then
            local dist = (d.Position - handle.Position).Magnitude
            if dist > farDist then farPart, farDist = d, dist end
        end
    end
    tool:SetAttribute("MuzzlePart", farPart and farPart.Name or "")
end

--───────────── ПОРТАЛЫ: СОСТОЯНИЕ ─────────────
local portalA, portalB = nil, nil
local tpCooldown = 0

local portalsChangedCallback = nil
local function notifyPortalsChanged()
    if portalsChangedCallback then
        pcall(portalsChangedCallback)
    end
end

local function releasePortalData(d)
    local changed = false
    if portalA == d then portalA = nil changed = true end
    if portalB == d then portalB = nil changed = true end
    if changed then notifyPortalsChanged() end
end

local function clearPortals()
    for _, p in ipairs({ portalA, portalB }) do
        if p then
            if p.close then
                task.spawn(p.close)
            elseif p.model.Parent then
                p.model:Destroy()
            end
        end
    end
    portalA, portalB = nil, nil
    notifyPortalsChanged()
end

local function claimPortalSlot()
    if not portalA then return "A" end
    if not portalB then return "B" end
    local old = portalA
    portalA = portalB
    portalB = nil
    if old and old.close then
        task.spawn(old.close)
    elseif old and old.model.Parent then
        old.model:Destroy()
    end
    return "B"
end

