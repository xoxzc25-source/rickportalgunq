--───────────── ПРАВИЛО ПРОБОЯ ─────────────
local function isGhost(inst)
    if not inst:IsA("BasePart") or inst == workspace.Terrain then
        return false
    end
    if inst.Transparency >= 0.85 then
        return true
    end
    if not inst.CanCollide and inst.Transparency >= 0.5 then
        return true
    end
    return false
end

--───────────── ПРИЦЕЛИВАНИЕ ─────────────
local function computeAim(char)
    local camPos = Camera.CFrame.Position

    local m
    if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
        m = Camera.ViewportSize / 2
    else
        m = UserInputService:GetMouseLocation()
    end
    local ray = Camera:ViewportPointToRay(m.X, m.Y)

    local exclude = { char }
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            table.insert(exclude, pl.Character)
        end
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    local firstPerson = root and (root.Position - camPos).Magnitude < 3

    local list = table.clone(exclude)
    local o, remaining = camPos, CONFIG.MAX_RANGE
    local nearSkips = 0

    for _ = 1, 24 do
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = list
        params.IgnoreWater = true

        local hit = workspace:Raycast(o, ray.Direction * remaining, params)
        if not hit then break end

        local used = (hit.Position - o).Magnitude

        if not firstPerson and used < 2.5 and nearSkips < 3 then
            nearSkips = nearSkips + 1
            table.insert(list, hit.Instance)
            o = hit.Position + ray.Direction * 0.05
            remaining = remaining - (used + 0.05)
            if remaining <= 0.05 then break end
        elseif isGhost(hit.Instance) then
            if debugAim then
                print(("[Portal Gun] пробито: %s (прозрачность %.2f, коллизия %s)")
                    :format(hit.Instance:GetFullName(),
                        hit.Instance.Transparency, tostring(hit.Instance.CanCollide)))
            end
            table.insert(list, hit.Instance)
            o = hit.Position + ray.Direction * 0.05
            remaining = remaining - (used + 0.05)
            if remaining <= 0.05 then break end
        else
            if debugAim then debugMarker(hit.Position) end
            return hit, ray, hit.Position, false
        end
    end

    local endPoint = camPos + ray.Direction * CONFIG.MAX_RANGE
    return nil, ray, endPoint, true
end

--───────────── ЖИДКАЯ СТРУЯ ─────────────
local function drawLiquidTracer(origin, aimPoint, fadeTip)
    local dir = (aimPoint - origin)
    local length = dir.Magnitude
    if length < 0.5 then return end
    dir = dir / length

    local right = dir:Cross(Vector3.yAxis)
    right = right.Magnitude > 0.05 and right.Unit or Vector3.xAxis
    local up = right:Cross(dir).Unit

    local holder = Instance.new("Model")
    holder.Name = "PG_Tracer"
    holder.Parent = workspace

    local anchor = Instance.new("Part")
    anchor.Size = Vector3.new(0.05, 0.05, 0.05)
    anchor.Transparency = 1
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.CanTouch = false
    anchor.CFrame = CFrame.new(origin)
    anchor.Parent = holder

    local SEGS = 10
    local atts = {}
    for i = 0, SEGS do
        local p = origin + dir * (length * i / SEGS)
        local a = Instance.new("Attachment")
        a.Parent = anchor   -- сначала парент к якорю
        a.WorldPosition = p -- потом мировая позиция (иначе струя съезжает)
        atts[i] = a
    end

    local basePos = {}
    for i = 0, SEGS do
        basePos[i] = atts[i].WorldPosition
    end

    local wmul = {}
    for i = 0, SEGS - 1 do
        if fadeTip then
            local f = i / SEGS
            wmul[i] = math.clamp((1 - f) / 0.3, 0, 1)
        else
            wmul[i] = 1
        end
    end

    local coreBeams, midBeams, outBeams = {}, {}, {}
    local W = 0.55
    for i = 0, SEGS - 1 do
        local function mk(col, emis, transp)
            local b = Instance.new("Beam")
            b.Attachment0 = atts[i]
            b.Attachment1 = atts[i + 1]
            b.Color = col
            b.LightEmission = emis
            b.LightInfluence = 0
            b.FaceCamera = true
            b.Segments = 1
            b.Transparency = transp
            b.Parent = holder
            return b
        end
        coreBeams[i] = mk(ColorSequence.new(CONFIG.C_CORE), 1, NumberSequence.new(0))
        midBeams[i]  = mk(ColorSequence.new(CONFIG.C_MAIN, CONFIG.C_DEEP), 1, NumberSequence.new(0.15))
        outBeams[i]  = mk(ColorSequence.new(CONFIG.C_DEEP), 0.6, NumberSequence.new(0.85))
        midBeams[i].Texture = "rbxasset://textures/particles/sparkles_main.dds"
        midBeams[i].TextureMode = Enum.TextureMode.Wrap
        midBeams[i].TextureLength = 2.5
        midBeams[i].TextureSpeed = 3
    end

    local droplets = {}
    local dropletIdx = fadeTip and { 2, 4 } or { 2, 4, 6 }
    for _, i in ipairs(dropletIdx) do
        local em = Instance.new("ParticleEmitter")
        em.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        em.Color = ColorSequence.new(CONFIG.C_MAIN, CONFIG.C_DEEP)
        em.LightEmission = 1
        em.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.18),
            NumberSequenceKeypoint.new(1, 0),
        })
        em.Transparency = NumberSequence.new(0.1, 1)
        em.Lifetime = NumberRange.new(0.25, 0.5)
        em.Rate = 40
        em.Speed = NumberRange.new(1, 3)
        em.SpreadAngle = Vector2.new(180, 180)
        em.Acceleration = Vector3.new(0, -18, 0)
        em.Parent = atts[i]
        table.insert(droplets, em)
    end

    local LIFE = 0.45
    local ATTACK, SUSTAIN_END = 0.14, 0.5
    local AMP = 0.5

    task.spawn(function()
        local t0 = os.clock()
        while holder.Parent do
            local el = os.clock() - t0
            local a = math.clamp(el / LIFE, 0, 1)

            local alpha
            if a < ATTACK then
                alpha = easeOutCubic(a / ATTACK)
            elseif a < SUSTAIN_END then
                alpha = 1
            else
                alpha = 1 - easeInOutSine((a - SUSTAIN_END) / (1 - SUSTAIN_END))
            end

            local waveT = el * 14
            for i = 1, SEGS - 1 do
                local frac = i / SEGS
                local envelope = math.sin(frac * math.pi)
                local off = right * (math.sin(waveT + frac * 6) * AMP * envelope)
                    + up * (math.cos(waveT * 0.8 + frac * 5) * AMP * 0.5 * envelope)
                atts[i].WorldPosition = basePos[i] + off * alpha
            end

            local w = alpha * (1 + math.sin(el * 26) * 0.07)
            for i = 0, SEGS - 1 do
                local wm = wmul[i] * w
                coreBeams[i].Width0 = W * 0.27 * wm
                coreBeams[i].Width1 = W * 0.27 * wm
                midBeams[i].Width0 = W * wm
                midBeams[i].Width1 = W * wm
                outBeams[i].Width0 = W * 2.27 * wm
                outBeams[i].Width1 = W * 2.27 * wm

                local tip = 1 - wmul[i]
                coreBeams[i].Transparency = NumberSequence.new(
                    math.clamp((1 - alpha) + tip, 0, 1))
                midBeams[i].Transparency = NumberSequence.new(
                    math.clamp((1 - alpha * 0.82) + tip, 0, 1))
                outBeams[i].Transparency = NumberSequence.new(
                    math.clamp((1 - alpha * 0.18) + tip, 0, 1))
            end

            for _, em in ipairs(droplets) do
                em.Rate = 40 * alpha
            end

            if a >= 1 then break end
            RunService.Heartbeat:Wait()
        end
        holder:Destroy()
    end)

    Debris:AddItem(holder, 1)
end

