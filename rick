        end

        local both = { myChar, tChar }
        clearPortals()

        local myPos, myNorm = groundPortalUnder(myChar, both)
        if myPos then openPortalAt(myPos, myNorm) end

        local tPos, tNorm = groundPortalUnder(tChar, both)
        if tPos then openPortalAt(tPos, tNorm) end

        return true
