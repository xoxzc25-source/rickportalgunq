local tpAnimBusy = false

local function restoreCollisions(saved)
    for part, v in pairs(saved) do
        if part.Parent then part.CanCollide = v end
    end
end

local function teleportThrough(from, to)
    tpCooldown = os.clock() + CONFIG.TP_COOLDOWN

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    local entrySpeed = hrp.AssemblyLinearVelocity.Magnitude
    local startCF = hrp.CFrame

    playSoundAt(hrp.Position, CONFIG.SOUND_TP, 0.9)

    local saved = {}
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            saved[d] = d.CanCollide
            d.CanCollide = false
        end
    end
    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.zero

    local baseFOV = Camera.FieldOfView
    local blur = Instance.new("BlurEffect")
    blur.Size = 0
    blur.Parent = Lighting

    local n = from.normal
    local r = n:Cross(Vector3.yAxis)
    r = r.Magnitude > 0.05 and r.Unit or Vector3.xAxis
    local u = r:Cross(n).Unit

    local dist = (startCF.Position - from.pos).Magnitude
    local pullDur = math.clamp(dist / 16, 0.12, 0.4)

    TweenService:Create(Camera,
        TweenInfo.new(pullDur, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { FieldOfView = baseFOV + 16 }):Play()

    local t0 = os.clock()
    while true do
        local t = (os.clock() - t0) / pullDur
        local dead = (not hrp.Parent) or (hum and hum.Health <= 0)
        if t >= 1 or dead then break end

        local e = easeInCubic(math.min(t, 1))
        local pos = startCF.Position:Lerp(from.pos, e)

        local amp = math.sin(e * math.pi) * 0.8
        local ang = e * 5.5
        pos = pos + r * (math.cos(ang) * amp) + u * (math.sin(ang) * amp)

        hrp.CFrame = CFrame.new(pos) * startCF.Rotation
        blur.Size = 14 * e
        RunService.Heartbeat:Wait()
    end

    local dead = (not hrp.Parent) or (hum and hum.Health <= 0)
    if dead then
        if hrp.Parent then hrp.Anchored = false end
        restoreCollisions(saved)
        TweenService:Create(Camera, TweenInfo.new(0.3), { FieldOfView = baseFOV }):Play()
        blur:Destroy()
        return
    end

    spawnRing(from.pos, from.normal, CONFIG.C_MAIN, 7, 0.3)

    local exitDir = to.normal
    if math.abs(exitDir.Y) > 0.9 then
        local flat = startCF.LookVector * Vector3.new(1, 0, 1)
        exitDir = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
    end

    local exitDist = CONFIG.PORTAL_SIZE * 0.5 + 1.4
    local exitStartPos = to.pos + to.normal * 0.1
    local exitEndPos = to.pos + to.normal * exitDist
    local startRot = startCF.Rotation
    local exitRot = CFrame.lookAt(Vector3.zero, exitDir)

    playSoundAt(to.pos, CONFIG.SOUND_TP, 1.2)
    spawnRing(to.pos, to.normal, CONFIG.C_MAIN, 7, 0.3)

    TweenService:Create(Camera,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { FieldOfView = baseFOV }):Play()
    TweenService:Create(blur, TweenInfo.new(0.4), { Size = 0 }):Play()
    Debris:AddItem(blur, 0.5)

    local exitDur = 0.32
    local t1 = os.clock()
    while true do
        local t = (os.clock() - t1) / exitDur
        local dead2 = (not hrp.Parent) or (hum and hum.Health <= 0)
        if t >= 1 or dead2 then break end

        local e = easeOutCubic(math.min(t, 1))
        local pos = exitStartPos:Lerp(exitEndPos, e)
        local rot = startRot:Lerp(exitRot, e)
        hrp.CFrame = CFrame.new(pos) * rot
        RunService.Heartbeat:Wait()
    end

    if hrp.Parent then
        hrp.CFrame = CFrame.new(exitEndPos) * startRot:Lerp(exitRot, 1)
        local outSpeed = math.clamp(entrySpeed * 0.85, 10, 120)
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = (exitDir + to.normal * 0.45).Unit * outSpeed
    end

    restoreCollisions(saved)
end

