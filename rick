local OPEN_DUR  = 0.45
local CLOSE_DUR = 0.45

local function openPortalAt(pos, normal)
    local slot = claimPortalSlot()
    playSoundAt(pos, CONFIG.SOUND_OPEN, 1)

    local holder = Instance.new("Model")
    holder.Name = "Portal_" .. slot
    holder.Parent = workspace

    local data = { model = holder, pos = pos, normal = normal, closed = false }

    local template = getPortalTemplate()
    local placed = false

    if template then
        local clone = template:Clone()
        clone.Parent = holder

        forceScaleAndCircle(clone, CONFIG.PORTAL_SIZE)

        local targetCF = CFrame.lookAt(pos + normal * 0.05, pos + normal * 2)
        clone:PivotTo(targetCF)

        local parts = {}
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                parts[#parts + 1] = {
                    part = d,
                    rel  = targetCF:ToObjectSpace(d.CFrame),
                    size = d.Size,
                    tr   = d.Transparency,
                }
            end
        end

        local function applyPose(s, vis, ang)
            local pv = targetCF * CFrame.Angles(0, 0, ang)
            clone:PivotTo(pv)
            for _, e in ipairs(parts) do
                local p = e.part
                if p.Parent then
                    local lp = e.rel.Position
                    p.CFrame = pv * CFrame.new(lp.X * s, lp.Y * s, lp.Z) * e.rel.Rotation
                    p.Size = Vector3.new(
                        math.max(e.size.X * s, 0.01),
                        math.max(e.size.Y * s, 0.01),
                        e.size.Z)
                    p.Transparency = 1 - (1 - e.tr) * vis
                end
            end
        end

        applyPose(0.01, 0, 0)
        spawnRing(pos, normal, CONFIG.C_CORE, CONFIG.PORTAL_SIZE * 1.35, 0.5)

        local flashPart = Instance.new("Part")
        flashPart.Size = Vector3.new(0.2, 0.2, 0.2)
        flashPart.Transparency = 1
        flashPart.Anchored = true
        flashPart.CanCollide = false
        flashPart.CanQuery = false
        flashPart.CanTouch = false
        flashPart.CFrame = CFrame.new(pos + normal * 0.4)
        flashPart.Parent = holder

        local openLight = Instance.new("PointLight")
        openLight.Color = CONFIG.C_MAIN
        openLight.Range = 20
        openLight.Brightness = 8
        openLight.Parent = flashPart
        TweenService:Create(openLight, TweenInfo.new(0.5), { Brightness = 0 }):Play()

        local angle = 0

        data.close = function()
            if data.closed then return end
            data.closed = true
            releasePortalData(data)
            if not holder.Parent then return end

            spawnRing(pos, normal, CONFIG.C_CORE, CONFIG.PORTAL_SIZE, 0.4)
            playSoundAt(pos, CONFIG.SOUND_OPEN, 1.3)

            local ct0 = os.clock()
            while holder.Parent do
                local t = math.min((os.clock() - ct0) / CLOSE_DUR, 1)
                local s = 1 - easeInCubic(t)
                applyPose(math.max(s, 0.01), 1 - t, angle)
                if t >= 1 then break end
                RunService.Heartbeat:Wait()
            end
            if holder.Parent then holder:Destroy() end
        end

        task.spawn(function()
            local t0 = os.clock()
            local last = t0
            while true do
                local now = os.clock()
                local dt = now - last
                last = now
                local t = math.min((now - t0) / OPEN_DUR, 1)
                local s = easeOutBack(t, 1.2)
                local vis = math.min(s, 1)

                angle = angle + math.rad(CONFIG.PORTAL_SPIN) * dt * math.min(s, 1.2)
                applyPose(s, vis, angle)

                if t >= 1 then break end
                RunService.Heartbeat:Wait()
            end
            applyPose(1, 1, angle)

            local bornAt = os.clock()
            while clone.Parent and not data.closed
                and (os.clock() - bornAt) < (CONFIG.PORTAL_LIFETIME - CLOSE_DUR) do
                local dt = task.wait(0.03)
                angle = angle + math.rad(CONFIG.PORTAL_SPIN) * dt
                clone:PivotTo(targetCF * CFrame.Angles(0, 0, angle))
            end

            if clone.Parent then
                data.close()
            end
        end)

        placed = true
    end

    if not placed then
        buildFallbackVisual(holder, pos, normal, CONFIG.PORTAL_SIZE)
        data.close = function()
            if data.closed then return end
            data.closed = true
            releasePortalData(data)
            if holder.Parent then holder:Destroy() end
        end
        task.delay(CONFIG.PORTAL_LIFETIME, function()
            if holder.Parent then data.close() end
        end)
    end

    local lightPart = Instance.new("Part")
    lightPart.Size = Vector3.new(0.2, 0.2, 0.2)
    lightPart.Transparency = 1
    lightPart.Anchored = true
    lightPart.CanCollide = false
    lightPart.CanQuery = false
    lightPart.CanTouch = false
    lightPart.CFrame = CFrame.new(pos + normal * 0.6)
    lightPart.Parent = holder

    local light = Instance.new("PointLight")
    light.Color = CONFIG.C_MAIN
    light.Range = 16
    light.Brightness = 2.5
    light.Parent = lightPart

    Debris:AddItem(holder, CONFIG.PORTAL_LIFETIME + 3)

    data.slot = slot
    if slot == "A" then portalA = data else portalB = data end
    notifyPortalsChanged()
end

