local function fire()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if not (equippedTool and equippedTool == currentTool
        and equippedTool.Parent == char) then return end

    if fireBusy then return end
    fireBusy = true
    task.delay(CONFIG.FIRE_COOLDOWN, function() fireBusy = false end)

    local hit, ray, endPoint, voidShot = computeAim(char)

    local muzzleName = currentTool:GetAttribute("MuzzlePart") or ""
    local muzzle = muzzleName ~= ""
        and currentTool:FindFirstChild(muzzleName, true) or nil
    local origin
    if muzzle then
        origin = muzzle.Position
    else
        local arm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
        origin = arm and arm.Position or char:GetPivot().Position
    end

    playSoundAt(origin, CONFIG.SOUND_FIRE, 1)
    drawLiquidTracer(origin, endPoint, voidShot)

    if hit then
        openPortalAt(hit.Position, hit.Normal)
    elseif CONFIG.SKY_PORTALS then
        openPortalAt(endPoint, -ray.Direction)
    end
end

