local function isStudio()
    local ok = pcall(function() return game:GetService("RunService"):IsStudio() end)
    return ok and game:GetService("RunService"):IsStudio()
end

local function loadFromStorage(name)
    local obj = ReplicatedStorage:FindFirstChild(name)
    if obj then
        local clone = obj:Clone()
        print(("[Portal Gun] '%s' загружено из ReplicatedStorage ✅"):format(name))
        return clone
    end
    return nil
end

local function loadById(id)
    local ok, result = pcall(function()
        return game:GetObjects(id)
    end)
    if not ok or type(result) ~= "table" or #result == 0 then
        return nil
    end
    for _, obj in ipairs(result) do
        if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Accoutrement") then
            return obj
        end
    end
    return result[1]
end

local function loadGunModel()
    local stored = loadFromStorage(CONFIG.RS_GUN_NAME)
    if stored then return stored end

    local asset = loadById("rbxassetid://" .. CONFIG.GUN_ID)
    if asset then return asset end

    if not isStudio() then
        warn("[Portal Gun] В ОПУБЛИКОВАННОЙ ИГРЕ GetObjects НЕ РАБОТАЕТ.")
        warn("[Portal Gun] Положи модель пушки в ReplicatedStorage с именем '"
            .. CONFIG.RS_GUN_NAME .. "'")
    else
        warn("[Portal Gun] Пушка не загрузилась по ID " .. CONFIG.GUN_ID)
    end
    return nil
end

--───────────── ШАБЛОН ПОРТАЛА ─────────────
local portalTemplate = nil
local portalTemplateTried = false

local function getPortalTemplate()
    if portalTemplateTried then return portalTemplate end
    portalTemplateTried = true

    local asset = loadFromStorage(CONFIG.RS_PORTAL_NAME)
    if not asset then
        asset = loadById(CONFIG.PORTAL_MODEL_ID)
    end

    if not asset then
        portalTemplateTried = false -- ретрай на следующем выстреле
        warn("[Portal Gun] МОДЕЛЬ ПОРТАЛА не загрузилась → fallback")
        if not isStudio() then
            warn("[Portal Gun] Положи модель портала в ReplicatedStorage с именем '"
                .. CONFIG.RS_PORTAL_NAME .. "'")
        end
        return nil
    end

    local container = Instance.new("Model")
    container.Name = "PortalTemplate"
    asset.Parent = container

    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("BaseScript") or d:IsA("Sound") then d:Destroy() end
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
        end
    end

    portalTemplate = container
    print("[Portal Gun] Модель портала готова ✅")
    return portalTemplate
end

--───────────── МАСШТАБ + КРУГЛОСТЬ ─────────────
local function forceScaleAndCircle(clone, targetSize)
    local _, size = clone:GetBoundingBox()
    local maxDim = math.max(size.X, size.Y, size.Z)
    if maxDim < 0.01 then return end

    local ok = pcall(function() clone:ScaleTo(targetSize / maxDim) end)
    if not ok then
        local k = targetSize / maxDim
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then d.Size = d.Size * k end
            if d:IsA("SpecialMesh") then d.Scale = d.Scale * k end
        end
    end

    local bbCF, size2 = clone:GetBoundingBox()
    if math.abs(size2.X - size2.Y) > 0.05 then
        local kx, ky = 1, 1
        if size2.X < size2.Y then
            kx = size2.Y / size2.X
        else
            ky = size2.X / size2.Y
        end
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                local rel = bbCF:ToObjectSpace(d.CFrame)
                local p = rel.Position
                d.CFrame = bbCF * CFrame.new(p.X * kx, p.Y * ky, p.Z) * rel.Rotation
                d.Size = Vector3.new(d.Size.X * kx, d.Size.Y * ky, d.Size.Z)
            elseif d:IsA("SpecialMesh") then
                d.Scale = Vector3.new(d.Scale.X * kx, d.Scale.Y * ky, d.Scale.Z)
            end
        end
    end

    local cf = clone:GetBoundingBox()
    local pv = clone:GetPivot()
    clone:PivotTo(CFrame.new(cf.Position) * pv.Rotation)
end

