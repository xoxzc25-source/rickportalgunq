do
    local function groundPortalUnder(char, excludeChars)
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end

        local list = table.clone(excludeChars)
        local o = hrp.Position + Vector3.new(0, 2, 0)
        local remaining = 60

        for _ = 1, 16 do
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = list
            params.IgnoreWater = true

            local hit = workspace:Raycast(o, Vector3.new(0, -remaining, 0), params)
            if not hit then break end

            if isGhost(hit.Instance) then
                table.insert(list, hit.Instance)
                local used = (o.Y - hit.Position.Y) + 0.05
                o = hit.Position + Vector3.new(0, -0.05, 0)
                remaining = math.max(remaining - used, 1)
            else
                return hit.Position, Vector3.yAxis
            end
        end

        return hrp.Position - Vector3.new(0, 3, 0), Vector3.yAxis
    end

