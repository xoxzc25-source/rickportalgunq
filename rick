local function easeOutCubic(t)  return 1 - (1 - t) ^ 3 end
local function easeInCubic(t)   return t ^ 3 end
local function easeInOutSine(t) return -(math.cos(math.pi * t) - 1) / 2 end
local function easeOutBack(t, c)
    c = c or 1.2
    local u = t - 1
    return 1 + (c + 1) * u * u * u + c * u * u
end

